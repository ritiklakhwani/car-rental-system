{
  "name": "car-rental-system",
  "version": "1.0.0",
  "description": "A TypeScript/Express REST API for a car rental system with JWT authentication, ownership-based access control, and PostgreSQL via Prisma.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ritiklakhwani/car-rental-system.git"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "jwt",
    "rest-api",
    "car-rental"
  ],
  "author": "oceandev",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ritiklakhwani/car-rental-system/issues"
  },
  "homepage": "https://github.com/ritiklakhwani/car-rental-system#readme",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "prisma": "^6.19.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
